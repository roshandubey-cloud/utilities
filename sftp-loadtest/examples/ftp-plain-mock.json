{
  "version": 1,
  "exported_at": "2026-05-01T18:41:00Z",
  "comment": "Plain FTP load test against the local mockftpserver on 127.0.0.1:12121. No TLS — for runs you don't need to encrypt. ~60 files/min, 1 MB each, 30-second run.",
  "config": {
    "host": "127.0.0.1",
    "port": 12121,
    "protocol": "ftp",

    "upload_folder": "/inbox",
    "parallel_streams": 2,
    "duration_hours": 0.0084,
    "poll_seconds": 2,
    "track_id_timeout_seconds": 30,
    "max_consecutive_failures": 3,

    "normal_enabled": true,
    "files_per_minute": 60,
    "normal_min_mb": 1,
    "normal_max_mb": 1,
    "normal_content_type": "binary",
    "normal_users_csv": "u1,p1,small*\nu2,p2,small*\n",

    "large_enabled": false,
    "download_enabled": false
  }
}
